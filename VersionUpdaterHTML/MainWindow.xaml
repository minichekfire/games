<Window x:Class="InfinitariumManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Late Light — Content Manager" Height="820" Width="1260"
        Background="#0b0b0f" Foreground="#f0f0f0" FontFamily="Consolas">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#15151a"/>
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs">

            <TabItem Header="CHANGELOG">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnOpen" Content="Открыть HTML" Click="BtnOpen_Click" 
                                Background="#4d7cff" Foreground="White" Padding="10,5" Margin="0,0,10,0" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="BtnSave" Content="Сохранить HTML" Click="BtnSave_Click" 
                                Background="#ff4d4d" Foreground="White" Padding="10,5" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                        <TextBlock Text="Файл не выбран" x:Name="LblFilePath" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#aaa"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="LstVersions" Background="#1a1a20" BorderBrush="#333" Foreground="White"
                                 SelectionChanged="LstVersions_SelectionChanged" BorderThickness="1">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4d7cff"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2a2a35"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{Binding VersionTag}" FontWeight="Bold" FontSize="14" Foreground="#4d7cff"/>
                                        <TextBlock Text="{Binding ButtonText}" FontSize="11" Foreground="#aaa" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                            <StackPanel>
                                <GroupBox Header="Информация о версии" BorderBrush="#333" Foreground="#ccc">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#4d7cff" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <StackPanel Margin="5">
                                        <TextBlock Text="ID (например: v2.8)" Foreground="#aaa" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtId" />

                                        <TextBlock Text="Название кнопки (не переводится, одно на оба языка)" Foreground="#aaa" Margin="0,10,0,5"/>
                                        <TextBox x:Name="TxtButtonLabel" />

                                        <CheckBox x:Name="ChkUnreleased" Content="Unreleased (Красный стиль вкладки)" 
                                                  Foreground="#ff9999" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Список изменений" BorderBrush="#333" Foreground="#ccc" Margin="0,10,0,0">
                                    <GroupBox.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="#4d7cff" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GroupBox.HeaderTemplate>
                                    <StackPanel>
                                        <TextBlock Text="Каждая секция требует текст на RU и EN — строки должны соответствовать друг другу по порядку." 
                                                   Foreground="#666" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                        <ItemsControl x:Name="ListSections">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15151a" BorderBrush="#444" BorderThickness="1" Margin="0,0,0,15" Padding="15" CornerRadius="5">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="5"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox x:Name="CmbType" Grid.Column="0"
                                                                          SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                          ItemsSource="{Binding DataContext.SectionTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0">
                                                                    <Button Content="▲" Click="BtnMoveSectionUp_Click" Tag="{Binding}" 
                                                                            Width="28" Height="28" Padding="0" FontSize="10"
                                                                            Background="#222" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"
                                                                            ToolTip="Переместить вверх"/>
                                                                    <Button Content="▼" Click="BtnMoveSectionDown_Click" Tag="{Binding}" 
                                                                            Width="28" Height="28" Padding="0" FontSize="10" Margin="3,0,0,0"
                                                                            Background="#222" Foreground="#aaa" BorderBrush="#444" BorderThickness="1"
                                                                            ToolTip="Переместить вниз"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="4" Content="✕" Click="BtnRemoveSection_Click" 
                                                                        Tag="{Binding}" Background="#331111" Foreground="#ff4d4d" 
                                                                        BorderBrush="#ff4d4d" BorderThickness="1"
                                                                        Width="30" Height="30" FontWeight="Bold"/>
                                                            </Grid>

                                                            <Grid Visibility="{Binding IsCustomVisible}" Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="Заголовок секции (RU)" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding CustomTitleRu, UpdateSourceTrigger=PropertyChanged}" Foreground="#ff994d"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Заголовок секции (EN)" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding CustomTitleEn, UpdateSourceTrigger=PropertyChanged}" Foreground="#ff994d"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="Пункты (RU) — каждый с новой строки:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                                                    <TextBox Text="{Binding ItemsRuText, UpdateSourceTrigger=PropertyChanged}"
                                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                                             Height="120" VerticalScrollBarVisibility="Auto"
                                                                             FontFamily="Consolas" FontSize="13"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Пункты (EN) — каждый с новой строки:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                                                    <TextBox Text="{Binding ItemsEnText, UpdateSourceTrigger=PropertyChanged}"
                                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                                             Height="120" VerticalScrollBarVisibility="Auto"
                                                                             FontFamily="Consolas" FontSize="13"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Добавить секцию" Click="BtnAddSection_Click" 
                                                Background="#1a1a20" Foreground="#4d7cff" BorderBrush="#4d7cff" BorderThickness="1"
                                                Margin="0,5,0,20" Padding="8"/>
                                    </StackPanel>
                                </GroupBox>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Сохранить версию" Click="BtnUpdateVersion_Click" 
                                            Background="#4d7cff" Foreground="White" Padding="15,8" Margin="0,0,10,0" FontWeight="Bold" BorderThickness="0"/>
                                    <Button Content="Новая версия" Click="BtnNewVersion_Click" 
                                            Background="#222" Foreground="#4d7cff" Padding="15,8" Margin="0,0,10,0" BorderBrush="#4d7cff" BorderThickness="1"/>
                                    <Button Content="Удалить" Click="BtnDeleteVersion_Click" 
                                            Background="#333" Foreground="#ff4d4d" Padding="15,8" BorderThickness="0"/>

                                    <Separator Width="1" Background="#333" Margin="10,0"/>

                                    <Button Content="Экспорт версии (.txt)" Click="BtnExportSingleTxt_Click" 
                                        Background="#1a1a20" Foreground="#aaa" Padding="10,8" Margin="0,0,5,0" BorderBrush="#444" BorderThickness="1" ToolTip="Сохранить changelog текущей выбранной версии в TXT"/>

                                    <Button Content="Экспорт всего (.txt)" Click="BtnExportAllTxt_Click" 
                                        Background="#1a1a20" Foreground="#aaa" Padding="10,8" BorderBrush="#444" BorderThickness="1" ToolTip="Сохранить полный список изменений всех версий в один TXT файл"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="WIKI">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnWikiOpen" Content="Открыть wiki-data.json" Click="BtnWikiOpen_Click" 
                                Background="#4d7cff" Foreground="White" Padding="10,5" Margin="0,0,10,0" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="BtnWikiNew" Content="Новый файл вики" Click="BtnWikiNew_Click" 
                                Background="#222" Foreground="#4d7cff" Padding="10,5" Margin="0,0,10,0" BorderBrush="#4d7cff" BorderThickness="1"/>
                        <Button x:Name="BtnWikiSave" Content="Сохранить wiki-data.json" Click="BtnWikiSave_Click" 
                                Background="#ff4d4d" Foreground="White" Padding="10,5" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                        <TextBlock Text="Файл не выбран" x:Name="LblWikiFilePath" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#aaa"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ" Foreground="#4d7cff" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                            <Button DockPanel.Dock="Bottom" Content="+ Добавить категорию" Click="BtnAddCategory_Click"
                                    Background="#1a1a20" Foreground="#4d7cff" BorderBrush="#4d7cff" BorderThickness="1"
                                    Margin="0,8,0,0" Padding="8"/>
                            <ListBox x:Name="LstCategories" Background="#1a1a20" BorderBrush="#333" Foreground="White"
                                     BorderThickness="1" SelectionChanged="LstCategories_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#4d7cff"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2a2a35"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBox Text="{Binding NameRu, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0" Padding="2" FontWeight="Bold"
                                                     Foreground="#fff"/>
                                                <TextBox Text="{Binding NameEn, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0" Padding="2" FontSize="11"
                                                     Foreground="#aaa" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="✕" Click="BtnDeleteCategory_Click" Tag="{Binding}"
                                                Background="Transparent" Foreground="#ff4d4d" BorderThickness="0" Width="22" FontWeight="Bold"
                                                ToolTip="Удалить категорию"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="СТАТЬИ" Foreground="#4d7cff" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAddArticle" DockPanel.Dock="Bottom" Content="+ Добавить статью" Click="BtnAddArticle_Click"
                                    Background="#1a1a20" Foreground="#4d7cff" BorderBrush="#4d7cff" BorderThickness="1"
                                    Margin="0,8,0,0" Padding="8" IsEnabled="False"/>
                            <ListBox x:Name="LstArticles" Background="#1a1a20" BorderBrush="#333" Foreground="White"
                                     BorderThickness="1" SelectionChanged="LstArticles_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Padding" Value="6,5"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#4d7cff"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2a2a35"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="✕" Click="BtnDeleteArticle_Click" Tag="{Binding}"
                                                    Background="Transparent" Foreground="#ff4d4d" BorderThickness="0" Width="22" FontWeight="Bold"
                                                    ToolTip="Удалить статью"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <Grid Grid.Column="4" Margin="10,0,0,0">
                            <TextBlock x:Name="LblWikiEmptyState" Margin="4,10,0,0"
                                       Text="Выберите или создайте категорию слева, затем статью, чтобы начать редактирование."
                                       Foreground="#666" TextWrapping="Wrap" VerticalAlignment="Top"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ScrollArticleEditor" Visibility="Collapsed">
                                <StackPanel>
                                    <GroupBox Header="Статья" BorderBrush="#333" Foreground="#ccc">
                                        <GroupBox.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#4d7cff" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GroupBox.HeaderTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="Заголовок (RU)" Foreground="#aaa" Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtArticleTitleRu" TextChanged="TxtArticle_TextChanged" Tag="TitleRu"/>

                                            <TextBlock Text="Заголовок (EN)" Foreground="#aaa" Margin="0,10,0,5"/>
                                            <TextBox x:Name="TxtArticleTitleEn" TextChanged="TxtArticle_TextChanged" Tag="TitleEn"/>

                                            <TextBlock Text="Текст статьи (RU)" Foreground="#aaa" Margin="0,15,0,5"/>
                                            <TextBox x:Name="TxtArticleContentRu" TextChanged="TxtArticle_TextChanged" Tag="ContentRu"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Height="200" VerticalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas" FontSize="13"/>

                                            <TextBlock Text="Текст статьи (EN)" Foreground="#aaa" Margin="0,10,0,5"/>
                                            <TextBox x:Name="TxtArticleContentEn" TextChanged="TxtArticle_TextChanged" Tag="ContentEn"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     Height="200" VerticalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas" FontSize="13"/>

                                            <TextBlock Text="Изменения применяются сразу. Не забудьте сохранить wiki-data.json." 
                                                       Foreground="#666" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <StatusBar Grid.Row="1" Background="#050508" Foreground="#aaa" BorderBrush="#333">
            <StatusBarItem>
                <TextBlock x:Name="LblStatus">Готов к работе</TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>